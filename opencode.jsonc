{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "google": {
      "apiKey": "AQ.Ab8RN6Kh8O7XS3UVe-Df-9NFyU3GywgBXPG7kXIVegYae4M2sw"
    },
    "cerebras": {
      "api": "https://api.cerebras.ai/v1",
      "apiKey": "csk-xjyhnvx9ex4nknpee58v2h6x645d4nh5n9w2vy34jw3j9mme"
    },
    "groq": {
      "api": "https://api.groq.com/openai/v1",
      "apiKey": "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"
    },
    "openrouter": {
      "api": "https://openrouter.ai/api/v1",
      "apiKey": "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"
    }
  },
  "agent": {
    "academix": {
      "mode": "primary",
      "description": "Academix v13.4 full-stack agent. VBA development, thesis pipeline, journal submission, CrossFlow coordination.",
      "model": "google/gemini-2.5-flash",
      "variant": "gemini-3.5-flash",
      "temperature": 0.3,
      "prompt": "{file:.opencode/prompts/resume-academix.md}",
      "tools": {
        "write": true,
        "edit": true,
        "bash": true,
        "read": true,
        "grep": true,
        "glob": true
      }
    },
    "academix-safety": {
      "mode": "subagent",
      "description": "Read-only safety reviewer for file system operations. Audits before destructive changes.",
      "model": "google/gemini-2.5-flash",
      "temperature": 0.1,
      "hidden": true,
      "tools": {
        "write": false,
        "edit": false
      },
      "permission": {
        "bash": {
          "*": "deny",
          "git diff": "allow",
          "git log*": "allow",
          "grep *": "allow",
          "cat *": "allow",
          "Get-*": "allow",
          "Test-Path*": "allow"
        }
      }
    },
    "academix-thesis": {
      "mode": "subagent",
      "description": "Thesis DOCX pipeline specialist. Builds, verifies, and measures thesis and English paper DOCX/PDF output.",
      "model": "google/gemini-2.5-flash",
      "variant": "gemini-3.5-flash",
      "temperature": 0.2,
      "tools": {
        "write": false,
        "edit": false
      },
      "permission": {
        "bash": {
          "*": "ask",
          "python *": "allow",
          "pandoc *": "allow",
          "& *build-thesis*": "allow",
          "& *build-english*": "allow",
          "& *verify-*": "allow"
        }
      }
    }
  },
  "default_agent": "academix"
}
